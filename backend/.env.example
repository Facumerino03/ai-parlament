# Groq API Configuration
# Get your free API key at: https://console.groq.com/
# IMPORTANT: Requires Python 3.10-3.12 (NOT 3.13+)
OPENROUTER_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_BASE_URL=https://api.groq.com/openai/v1

# LLM Models (Groq)
# Available models: https://console.groq.com/docs/models
MODEL_GEMINI=llama-3.3-70b-versatile
MODEL_LLAMA=llama-3.1-8b-instant

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# RAG Configuration
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# Debate Configuration
DEFAULT_ROUNDS=3
MAX_TOKENS_PER_ARGUMENT=180
TEMPERATURE_DEFAULT=0.7

# Rate Limiting (Groq limits: llama-3.1-8b: 14.4K RPM, llama-3.3-70b: 1K RPM)
# With 11 agents, we need ~2-3 seconds between calls to stay under 1K RPM for 70b
API_CALL_DELAY=2.5
MAX_RETRIES=2
